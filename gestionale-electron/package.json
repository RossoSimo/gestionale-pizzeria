{
  "name": "gestionale-electron",
  "version": "1.0.0",
  "description": "Electron + React app for pizzeria local-first POS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run prisma:generate && wait-on tcp:5173 && electron .",
    "prisma:generate": "prisma generate",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "build": "vite build",
    "start": "npm run prisma:generate && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/client": "^7.5.0",
    "better-sqlite3": "^12.8.0",
    "electron": "^41.1.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  }
}
