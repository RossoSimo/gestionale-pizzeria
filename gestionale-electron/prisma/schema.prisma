// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Ora usiamo sqlite per il gestionale locale in pizzeria
  provider = "sqlite"
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  CONFLICT
}

enum OrderStatus {
  IN_ATTESA
  IN_PREPARAZIONE
  PRONTO
  CONSEGNATO
  CONFERMATO
  ANNULLATO
}

enum OrderType {
  ASPORTO
  DOMICILIO
}

enum ModifierAction {
  AGGIUNGI
  RIMUOVI
}

enum Weekday {
  LUNEDI
  MARTEDI
  MERCOLEDI
  GIOVEDI
  VENERDI
  SABATO
  DOMENICA
}

// ------------------------------------------------------------------
// 1. ANAGRAFICA E PRODOTTI
// ------------------------------------------------------------------

model Customer {
  id        String    @id @default(uuid())
  name      String
  //surname   String
  phone     String?
  address   String?
  notes     String?   // Es: "Citofono rotto", "Cane cattivo"
  isTemporary Boolean  @default(false)
  temporaryBusinessDate DateTime?
  
  orders    Order[]

  // Metadati per sincronizzazione offline-first
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  syncStatus SyncStatus @default(PENDING)
  lastSyncedAt DateTime?

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
  @@index([isTemporary, temporaryBusinessDate])
}

model Product {
  id          String          @id @default(uuid())
  name        String          // Es: "Margherita", "Coca Cola 33cl"
  description String?
  priceCents  Int
  category    String
  
  orderItems  OrderItem[]
  productIngredients ProductIngredient[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  version     Int             @default(1)
  syncStatus  SyncStatus      @default(PENDING)
  lastSyncedAt DateTime?

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

model Ingredient {
  id                  String    @id @default(uuid())
  name                String    // Es: "Salame Piccante", "Mozzarella"
  extraPriceCents     Int       @default(0)
  removeDiscountCents Int       @default(0)
  
  productIngredients ProductIngredient[]
  modifiers OrderItemModifier[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  version     Int         @default(1)
  syncStatus  SyncStatus  @default(PENDING)
  lastSyncedAt DateTime?

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

model ProductIngredient {
  id            String      @id @default(uuid())

  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredientId   String
  ingredient     Ingredient  @relation(fields: [ingredientId], references: [id])

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  version        Int         @default(1)
  syncStatus     SyncStatus  @default(PENDING)
  lastSyncedAt   DateTime?

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

// ------------------------------------------------------------------
// 2. ORDINI E DETTAGLI (IL CUORE DEL GESTIONALE)
// ------------------------------------------------------------------

model Order {
  id               String      @id @default(uuid())
  businessDate     DateTime
  dailyNumber      Int         // Numero leggibile per il pizzaiolo (es. Ordine #42)
  status           OrderStatus
  type             OrderType
  totalAmountCents Int
  notes            String?     // Nota generale dell'ordine
  
  expectedAt       DateTime? // Orario di ritiro o consegna richiesto
  
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  
  items            OrderItem[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  version          Int         @default(1)
  syncStatus       SyncStatus  @default(PENDING)
  lastSyncedAt     DateTime?

  @@unique([businessDate, dailyNumber])
  @@index([status])
  @@index([expectedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

model OrderItem {
  id             String    @id @default(uuid())
  quantity       Int       @default(1)
  unitPriceCents Int       // Prezzo bloccato al momento dell'ordine
  notes          String?   // Note libere: es. "Ben cotta"
  
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId      String
  product        Product   @relation(fields: [productId], references: [id])

  modifiers      OrderItemModifier[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  version        Int         @default(1)
  syncStatus     SyncStatus  @default(PENDING)
  lastSyncedAt   DateTime?

  @@index([orderId])
  @@index([productId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

// Questa tabella gestisce le variazioni: "CON", "SENZA", "DOPPIO"
model OrderItemModifier {
  id               String         @id @default(uuid())
  action           ModifierAction
  priceAppliedCents Int           // Costo della variazione bloccato al momento dell'ordine
  
  orderItemId      String
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  ingredientId     String
  ingredient       Ingredient     @relation(fields: [ingredientId], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  version          Int            @default(1)
  syncStatus       SyncStatus     @default(PENDING)
  lastSyncedAt     DateTime?

  @@index([orderItemId])
  @@index([ingredientId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

model AppSettings {
  id            String     @id @default("default")
  openingTime   String     @default("18:00")
  closingTime   String     @default("23:00")
  slotMinutes   Int        @default(20)
  categoryPizzaLabel   String @default("Pizze")
  categoryBevandaLabel String @default("Bevanda")
  categoryAltroLabel   String @default("Altro")
  extraCategoriesJson  String @default("[]")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  version       Int        @default(1)
  syncStatus    SyncStatus @default(PENDING)
  lastSyncedAt  DateTime?

  businessDays  BusinessDaySettings[]
}

model BusinessDaySettings {
  id            String     @id @default(uuid())
  settingsId    String     @default("default")
  settings      AppSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  weekday       Weekday    @unique
  isOpen        Boolean    @default(true)
  openingTime   String     @default("18:00")
  closingTime   String     @default("23:00")
  slotMinutes   Int        @default(20)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  version       Int        @default(1)
  syncStatus    SyncStatus @default(PENDING)
  lastSyncedAt  DateTime?

  @@index([settingsId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}